{
  "name": "mini-mem",
  "version": "1.1.0",
  "description": "简版 Agent Memory Plugin — 第13章实战项目",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test:save": "echo '{\"session_id\":\"test\",\"cwd\":\"/tmp/demo\",\"hook_event_name\":\"PostToolUse\",\"tool_name\":\"Edit\",\"tool_input\":{\"file_path\":\"src/index.ts\"},\"tool_response\":{\"success\":true}}' | node dist/hooks/save-hook.js",
    "test:fail": "echo '{\"session_id\":\"test\",\"cwd\":\"/tmp/demo\",\"hook_event_name\":\"PostToolUseFailure\",\"tool_name\":\"Bash\",\"tool_input\":{\"command\":\"npm test\"},\"error\":\"Exit code 1\",\"is_interrupt\":false}' | node dist/hooks/save-hook.js",
    "test:context": "echo '{\"session_id\":\"test\",\"cwd\":\"/tmp/demo\",\"source\":\"startup\"}' | node dist/hooks/context-hook.js",
    "test:resume": "echo '{\"session_id\":\"test\",\"cwd\":\"/tmp/demo\",\"source\":\"resume\"}' | node dist/hooks/context-hook.js",
    "test:search": "node dist/mcp/test-client.js",
    "test:budget": "node dist/hooks/budget-test.js",
    "claude:dev": "claude --plugin-dir ./plugin"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.12"
  }
}
